<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- The Red background color -->
    <solid android:color="#D32F2F" />

    <!-- Optional: A thin white border to make it "pop" -->
    <stroke
        android:width="1.5dp"
        android:color="#FFFFFF" />

    <!-- Ensures it stays a perfect circle -->
    <size
        android:width="20dp"
        android:height="20dp" />
</shape>