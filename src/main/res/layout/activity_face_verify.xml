<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Face Verification"
        android:textSize="22sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etVerifyUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Username"
        android:layout_marginTop="10dp"
        android:inputType="text" />

    <!-- Camera Container with Overlay -->
    <FrameLayout
        android:layout_width="280dp"
        android:layout_height="320dp"
        android:layout_marginTop="20dp">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewViewVerify"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000" />

        <!-- This placeholder will be replaced by the FaceOverlayView in code -->
        <View
            android:id="@+id/faceGuideOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvVerifyStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textAlignment="center"
        android:text="Scanning for face..." />

    <Button
        android:id="@+id/btnStartVerify"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Verify My Identity" />

    <Button
        android:id="@+id/btnGoToRegister"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Register New Face"
        android:backgroundTint="#607D8B"
        android:layout_marginTop="5dp" />

    <TextView
        android:id="@+id/tvVerifyResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textSize="20sp"
        android:textStyle="bold" />

</LinearLayout>