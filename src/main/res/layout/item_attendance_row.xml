<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:weightSum="5"
    android:background="@drawable/bottom_border">

    <TextView android:id="@+id/colDate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:textSize="11sp" android:textColor="#000000"/>
    <TextView android:id="@+id/colAmIn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.95" android:textSize="10sp" android:gravity="center"/>
    <TextView android:id="@+id/colAmOut" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.95" android:textSize="10sp" android:gravity="center"/>
    <TextView android:id="@+id/colPmIn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.95" android:textSize="10sp" android:gravity="center"/>
    <TextView android:id="@+id/colPmOut" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.95" android:textSize="10sp" android:gravity="center"/>
</LinearLayout>