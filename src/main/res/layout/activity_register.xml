<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- COMMON HEADER -->
        <TextView
            android:id="@+id/tvSignUpTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="Sign Up"
            android:textColor="#1A73E8"
            android:textSize="36sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="Enter and Complete\nYour Account Details Below"
            android:textColor="#5F6368"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSignUpTitle" />

        <!-- STEP 1: PERSONAL DETAILS -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutStep1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <TextView
                android:id="@+id/lblFirstName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="First Name"
                android:textColor="#202124"
                android:textStyle="bold"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/etFirstName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edit_text_border"
                android:hint="Enter first name"
                android:padding="14dp"
                android:textColor="#202124"
                android:textColorHint="#9AA0A6"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/lblFirstName" />

            <TextView
                android:id="@+id/lblMiddleName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Middle Name"
                android:textColor="#202124"
                android:textStyle="bold"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etFirstName" />

            <EditText
                android:id="@+id/etMiddleName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edit_text_border"
                android:hint="Enter middle name"
                android:padding="14dp"
                android:textColor="#202124"
                android:textColorHint="#9AA0A6"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/lblMiddleName" />

            <TextView
                android:id="@+id/lblLastName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Last Name"
                android:textColor="#202124"
                android:textStyle="bold"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etMiddleName" />

            <EditText
                android:id="@+id/etLastName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edit_text_border"
                android:hint="Enter last name"
                android:padding="14dp"
                android:textColor="#202124"
                android:textColorHint="#9AA0A6"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/lblLastName" />

            <TextView
                android:id="@+id/lblYearSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Year and Section"
                android:textColor="#202124"
                android:textStyle="bold"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etLastName" />

            <Spinner
                android:id="@+id/spnYearSection"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edit_text_border"
                app:layout_constraintTop_toBottomOf="@id/lblYearSection" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="end"
                android:orientation="horizontal"
                android:spacing="12dp"
                app:layout_constraintTop_toBottomOf="@id/spnYearSection">

                <Button
                    android:id="@+id/btnBack1"
                    android:layout_width="100dp"
                    android:layout_height="50dp"
                    android:backgroundTint="#FFFFFF"
                    android:text="Back"
                    android:textColor="#1A73E8"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnNext1"
                    android:layout_width="100dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="12dp"
                    android:backgroundTint="#1A73E8"
                    android:text="Next"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutStep2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <TextView
                android:id="@+id/lblUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Username"
                android:textColor="#202124"
                android:textStyle="bold"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/etRegUsername"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edit_text_border"
                android:hint="Enter username"
                android:padding="14dp"
                android:textColor="#202124"
                android:textColorHint="#9AA0A6"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/lblUser" />

            <TextView
                android:id="@+id/lblPass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Password"
                android:textColor="#202124"
                android:textStyle="bold"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etRegUsername" />

            <EditText
                android:id="@+id/etRegPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edit_text_border"
                android:hint="Enter password (min 6 characters)"
                android:inputType="textPassword"
                android:padding="14dp"
                android:textColor="#202124"
                android:textColorHint="#9AA0A6"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/lblPass" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="end"
                android:orientation="horizontal"
                android:spacing="12dp"
                app:layout_constraintTop_toBottomOf="@id/etRegPassword">

                <Button
                    android:id="@+id/btnBack2"
                    android:layout_width="100dp"
                    android:layout_height="50dp"
                    android:backgroundTint="#FFFFFF"
                    android:text="Back"
                    android:textColor="#1A73E8"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnNext2"
                    android:layout_width="100dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="12dp"
                    android:backgroundTint="#1A73E8"
                    android:text="Next"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutStep3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <TextView
                android:id="@+id/tvFaceVerifyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Face Verification"
                android:textColor="#1A73E8"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cvCamera"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#000000"
                app:layout_constraintTop_toBottomOf="@id/tvFaceVerifyTitle">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#000000">

                    <androidx.camera.view.PreviewView
                        android:id="@+id/previewView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <com.example.myapplication.FaceOverlayView
                        android:id="@+id/faceOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="Align your face"
                android:textColor="#202124"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/cvCamera" />

            <TextView
                android:id="@+id/tvInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Position yourself in a well-lit area"
                android:textColor="#5F6368"
                android:textSize="13sp"
                app:layout_constraintTop_toBottomOf="@id/tvStatus" />

            <!-- INSTRUCTION SECTION START -->
            <LinearLayout
                android:id="@+id/llGuidelines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="#E8F0FE"
                android:orientation="vertical"
                android:padding="16dp"
                app:layout_constraintTop_toBottomOf="@id/tvInstructions">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ Verification Guidelines"
                    android:textColor="#1A73E8"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="For seamless face verification in your time-in:"
                    android:textColor="#3C4043"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="• Make sure the top of your eyes and eyebrows are not covered with hair\n• Do not wear a mask or dark shades\n• Perfectly align your face within the frame\n• Ensure proper lighting on your face"
                    android:textColor="#202124"
                    android:textSize="13sp"
                    android:lineSpacingExtra="6dp" />
            </LinearLayout>


            <Button
                android:id="@+id/btnScan"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="26dp"
                android:backgroundTint="#1A73E8"
                android:enabled="false"
                android:text="Capture Face"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/llGuidelines" />

            <Button
                android:id="@+id/btnFinalRegister"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#34A853"
                android:text="Complete Registration"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/btnScan" />

            <Button
                android:id="@+id/btnBack3"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#FFFFFF"
                android:text="Back"
                android:textColor="#1A73E8"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/btnFinalRegister" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>